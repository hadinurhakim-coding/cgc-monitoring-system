{
	"name": "gcg-monitoring-system",
	"version": "0.0.1",
	"packageManager": "bun@1.3.11",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"seed:acgs": "bun run scripts/seed-db.ts",
		"sync:acgs:year": "bun run scripts/sync-acgs-master-to-year.ts",
		"db:schema:snapshot": "supabase db dump --schema public --local > docs/db/schema.snapshot.sql"
	},
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"layerchart": "2.0.0-next.48",
		"supabase": "^2.109.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@dotlottie/player-component": "^2.7.12",
		"@lottiefiles/dotlottie-svelte": "^0.9.9",
		"@supabase/supabase-js": "^2.100.1",
		"docx": "^9.7.1",
		"dotenv": "^17.4.0",
		"exceljs": "^4.4.0",
		"file-type": "^22.0.0",
		"pg": "^8.20.0",
		"supports-color": "^10.2.2",
		"svelte-sonner": "^1.1.0"
	}
}
